model Favorite {
  userId       String   @db.Uuid
  assessmentId Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  categoryAtAdd String
  versionAtAdd  String

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment RedListAssessment @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade)

  @@id([userId, assessmentId])
  @@index([userId, createdAt])
  @@map("favorites")
}