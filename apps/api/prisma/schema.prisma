generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  pseudo       String    @unique
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions     Session[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent  String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RedListSync {
  id             String   @id @default("singleton")
  redListVersion String
  lastSyncedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@map("red_list_sync")
}

model RedListLocation {
  assessmentId Int
  countryCode  String @db.Char(2)

  assessment RedListAssessment @relation(fields: [assessmentId], references: [assessmentId], onDelete: Cascade)

  @@id([assessmentId, countryCode])
  @@index([countryCode])
  @@map("red_list_locations")
}

model RedListAssessment {
  assessmentId    Int       @id
  sisTaxonId      Int?
  scientificName  String
  categoryCode    String
  scopeCode       Int
  criteria        String?
  yearPublished   Int?
  assessmentDate  DateTime? @db.Timestamptz(3)
  possiblyExtinct Boolean   @default(false)
  officialUrl     String?
  redListVersion  String

  locations        RedListLocation[]

  vernacularNameFr String?
  photoUrl         String?
  photoAttribution String?
  photoLicense     String?
  mediaFetchedAt   DateTime? @db.Timestamptz(3)

  description        String?
  descriptionSource  String?
  descriptionFetchedAt DateTime? @db.Timestamptz(3)

  detail          Json?     @db.JsonB
  detailFetchedAt DateTime? @db.Timestamptz(3)

  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([categoryCode, scientificName])
  @@map("red_list_assessments")
}